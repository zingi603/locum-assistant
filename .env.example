# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL=postgresql://locum:locum@localhost:5432/locum

# "extractive" needs no key. "anthropic" calls Claude directly. "openrouter" goes through OpenRouter.
LLM_PROVIDER=extractive
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5

# Comma-separated keys clients must send as X-API-Key. Leave empty only for local development.
API_KEYS=
